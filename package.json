{
  "name": "bigeye",
  "version": "1.0.0",
  "author": "fabio conti",
  "description": "a big eye app",
  "keywords": [],
  "license": "MIT",
  "main": "public/main.js",
  "homepage": "./",
  "dependencies": {
    "@emotion/react": "11.10.6",
    "@emotion/styled": "11.10.6",
    "@mui/icons-material": "5.11.11",
    "@mui/material": "5.11.15",
    "@mui/x-data-grid": "^6.19.6",
    "@mui/x-date-pickers": "6.0.4",
    "@mui/x-date-pickers-pro": "6.0.4",
    "@wojtekmaj/react-datetimerange-picker": "^5.5.0",
    "cors": "^2.8.5",
    "date-fns": "2.30.0",
    "electron-squirrel-startup": "^1.0.0",
    "express": "^4.19.1",
    "level": "^8.0.1",
    "react": "18.2.0",
    "react-big-calendar": "1.11.2",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "18.2.0",
    "react-router-dom": "^6.10.0",
    "react-scripts": "^5.0.1",
    "react-trello": "^2.2.11"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/runtime": "7.13.8",
    "@electron-forge/cli": "^7.3.1",
    "@electron-forge/maker-deb": "^7.3.1",
    "@electron-forge/maker-rpm": "^7.3.1",
    "@electron-forge/maker-squirrel": "^7.3.1",
    "@electron-forge/maker-zip": "^7.3.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.3.1",
    "@electron-forge/plugin-fuses": "^7.3.1",
    "electron": "^29.1.5",
    "typescript": "4.1.3"
  },
  "scripts": {
    "start": "electron-forge start",
    "dev": "react-scripts start",
    "build": "react-scripts build --legacy-peer-deps",
    "test": "react-scripts test --env=jsdom",
    "eject": "react-scripts eject",
    "electron": "electron .",
    "newelectron": "react-scripts build --legacy-peer-deps && electron .",
    "forge:build": "electron-forge build",
    "forge:dev": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ],
  "config": {
    "forge": {
      "packagerConfig": {
        "icon": "build/bigeye2",
        "asar": false,
        "ignore": [
          "^/src$",
          "^/db$"
        ]
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "big_eye"
          }
        }
      ],
      "publishers": []
    }
  }
}